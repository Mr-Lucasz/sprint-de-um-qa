{
  "info": {
    "_postman_id": "0a6e1d3e-7f62-4d44-9af7-5a8a0d8e0505",
    "name": "Inscrevi - US05 Minhas inscrições",
    "description": "Coleção da US05 (Minhas inscrições), baseada no plano de teste da história #5 e no contrato da API. Execute em ordem. Preencha os IDs de usuário e curso no ambiente antes de iniciar. Os scripts ficam em Scripts > Post-response.",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: '*/*' });",
          "if (pm.request.body && pm.request.body.mode === 'raw') {",
          "  pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('a API não retorna erro 5xx', () => pm.expect(pm.response.code).to.be.below(500));",
          "if (pm.response.text()) {",
          "  pm.test('resposta com corpo declara JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Preparação e autenticação",
      "description": "Faça login como aluno e administrador. Os scripts salvam os tokens para as pastas seguintes.",
      "item": [
        {
          "name": "Login - estudante",
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"senha\": \"{{studentPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login do estudante responde 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('login devolve token', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
                  "pm.test('login devolve usuário aluno', () => pm.expect(body.usuario.perfil).to.eql('aluno'));",
                  "pm.environment.set('studentToken', body.token);",
                  "pm.environment.set('studentId', String(body.usuario.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - administrador",
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"senha\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login do administrador responde 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('login devolve perfil administrador', () => pm.expect(body.usuario.perfil).to.eql('admin'));",
                  "pm.environment.set('adminToken', body.token);",
                  "pm.environment.set('adminId', String(body.usuario.id));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Regra 1 - Consultar próprias inscrições",
      "description": "Partição de equivalência: a consulta autenticada da própria conta deve responder 200 e retornar uma lista.",
      "item": [
        {
          "name": "Estudante consulta as próprias inscrições",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios/{{studentId}}/inscricoes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "{{studentId}}",
                "inscricoes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('estudante consulta a própria conta com 200', () => pm.response.to.have.status(200));",
                  "const inscricoes = pm.response.json();",
                  "pm.test('resposta é uma lista', () => pm.expect(inscricoes).to.be.an('array'));",
                  "inscricoes.forEach((inscricao) => {",
                  "  pm.expect(inscricao).to.have.property('id');",
                  "  pm.expect(inscricao).to.have.property('cursoId');",
                  "  pm.expect(inscricao).to.have.property('criadaEm');",
                  "  pm.expect(inscricao).to.have.property('curso');",
                  "  pm.expect(inscricao.curso).to.have.property('titulo');",
                  "});",
                  "pm.environment.set('initialEnrollmentCount', String(inscricoes.length));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Regra 3 - Controle de acesso",
      "description": "Tabela de decisão: estudante só consulta a própria conta; administrador consulta a conta de outra pessoa; sem token recebe 401.",
      "item": [
        {
          "name": "Estudante consulta inscrições de outra pessoa",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios/{{otherUserId}}/inscricoes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "{{otherUserId}}",
                "inscricoes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('estudante não consulta outra conta', () => pm.response.to.have.status(403));",
                  "const body = pm.response.json();",
                  "pm.test('resposta negada informa a mensagem', () => pm.expect(body.mensagem).to.be.a('string').and.not.empty);",
                  "pm.test('resposta negada não traz inscrições', () => {",
                  "  pm.expect(body).to.not.have.property('inscricoes');",
                  "  pm.expect(JSON.stringify(body)).to.not.include('cursoId');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Administrador consulta inscrições de outra pessoa",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios/{{otherUserId}}/inscricoes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "{{otherUserId}}",
                "inscricoes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('administrador consulta outra conta com 200', () => pm.response.to.have.status(200));",
                  "pm.test('resposta administrativa é uma lista', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consulta sem login",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios/{{studentId}}/inscricoes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "{{studentId}}",
                "inscricoes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('consulta sem token responde 401', () => pm.response.to.have.status(401));",
                  "pm.test('401 informa que é necessário login', () => pm.expect(pm.response.json().mensagem).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Regra 2 - Ciclo de inscrição",
      "description": "Valor limite e integração: criar uma inscrição, confirmar que ela aparece na listagem, cancelar e confirmar a lista vazia quando ela era a única inscrição.",
      "item": [
        {
          "name": "POST - Inscrever-se no curso",
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cursoId\": {{courseId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/inscricoes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inscricoes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('POST cria inscrição com 201', () => pm.response.to.have.status(201));",
                  "const inscricao = pm.response.json();",
                  "pm.test('inscrição possui contrato mínimo', () => {",
                  "  pm.expect(inscricao.id).to.be.a('number');",
                  "  pm.expect(inscricao.usuarioId).to.eql(Number(pm.environment.get('studentId')));",
                  "  pm.expect(inscricao.cursoId).to.eql(Number(pm.environment.get('courseId')));",
                  "  pm.expect(inscricao.criadaEm).to.be.a('string');",
                  "  pm.expect(inscricao.curso.titulo).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.environment.set('enrollmentId', String(inscricao.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET - Nova inscrição aparece na lista",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios/{{studentId}}/inscricoes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "{{studentId}}",
                "inscricoes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('listagem após POST responde 200', () => pm.response.to.have.status(200));",
                  "const inscricoes = pm.response.json();",
                  "pm.test('nova inscrição aparece na lista', () => pm.expect(inscricoes.some((item) => String(item.id) === pm.environment.get('enrollmentId'))).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE - Cancelar a inscrição criada",
          "request": {
            "method": "DELETE",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/inscricoes/{{enrollmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inscricoes",
                "{{enrollmentId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('cancelamento responde 204', () => pm.response.to.have.status(204));",
                  "pm.test('cancelamento não devolve corpo', () => pm.expect(pm.response.text()).to.eql(''));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET - Confirmar lista após cancelamento",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios/{{studentId}}/inscricoes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "{{studentId}}",
                "inscricoes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('listagem após cancelamento responde 200', () => pm.response.to.have.status(200));",
                  "const inscricoes = pm.response.json();",
                  "pm.test('inscrição cancelada não aparece mais', () => pm.expect(inscricoes.some((item) => String(item.id) === pm.environment.get('enrollmentId'))).to.eql(false));",
                  "if (pm.environment.get('initialEnrollmentCount') === '0') {",
                  "  pm.test('lista fica vazia quando era a única inscrição', () => pm.expect(inscricoes).to.be.empty);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
