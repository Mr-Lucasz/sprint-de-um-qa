{
  "info": {
    "name": "Inscrevi API — A Sprint de um QA",
    "description": "Coleção do dia 2. Rode com o app no ar (npm start). Cada requisição tem testes em pm.test na aba Scripts > Post-response. Documentação: https://learning.postman.com/docs/tests-and-scripts/write-scripts/test-scripts/",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Teste aplicado a TODAS as requisições da coleção",
          "pm.test('responde em menos de 1 segundo', () => {",
          "  pm.expect(pm.response.responseTime).to.be.below(1000);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 Preparação",
      "item": [
        {
          "name": "Restaurar dados iniciais",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "Deixa o app no estado inicial para a coleção ser repetível.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/test/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "test",
                "reset"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "01 Usuários (US01)",
      "item": [
        {
          "name": "Cadastrar usuário válido",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Massa dinâmica: um e-mail novo a cada execução",
                  "pm.collectionVariables.set('email', `postman${Date.now()}@teste.dev`);",
                  "pm.collectionVariables.set('senha', 'Senha@1234');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "const usuario = pm.response.json();",
                  "",
                  "pm.test('corpo segue o contrato', () => {",
                  "  pm.response.to.have.jsonSchema({",
                  "    type: 'object',",
                  "    required: ['id', 'nome', 'email', 'perfil'],",
                  "    properties: {",
                  "      id: { type: 'integer' },",
                  "      nome: { type: 'string' },",
                  "      email: { type: 'string' },",
                  "      perfil: { enum: ['aluno', 'admin'] },",
                  "    },",
                  "  });",
                  "});",
                  "",
                  "pm.test('não devolve a senha', () => {",
                  "  pm.expect(usuario).to.not.have.property('senha');",
                  "  pm.expect(usuario).to.not.have.property('senhaHash');",
                  "});",
                  "",
                  "pm.collectionVariables.set('usuarioId', usuario.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Aluna Postman\",\n  \"email\": \"{{email}}\",\n  \"senha\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Recusar senha com 7 caracteres (valor limite)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('mensagem explica a regra', () => {",
                  "  pm.expect(pm.response.json().mensagem).to.eql('A senha deve ter entre 8 e 64 caracteres.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Aluna Limite\",\n  \"email\": \"limite7@teste.dev\",\n  \"senha\": \"1234567\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Recusar e-mail duplicado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('mensagem de e-mail duplicado', () => {",
                  "  pm.expect(pm.response.json().mensagem).to.eql('Este e-mail já está cadastrado.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Cópia\",\n  \"email\": \"{{email}}\",\n  \"senha\": \"Senha@1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
