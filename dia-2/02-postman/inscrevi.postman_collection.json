    {
      "name": "03 Cursos (US03)",
      "item": [
        {
          "name": "Listar cursos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const cursos = pm.response.json();",
                  "pm.test('vagas disponíveis nunca passam do total', () => {",
                  "  cursos.forEach((c) => pm.expect(c.vagasDisponiveis).to.be.within(0, c.vagas));",
                  "});",
                  "const oficina = cursos.find((c) => c.titulo === 'Oficina de acessibilidade web');",
                  "pm.collectionVariables.set('cursoId', oficina.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "description": "",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/cursos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cursos"
              ]
            }
          }
        }
      ]
    },
    {
