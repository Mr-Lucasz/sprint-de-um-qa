    {
      "name": "02 Login (US02)",
      "item": [
        {
          "name": "Entrar com credenciais válidas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const { token, usuario } = pm.response.json();",
                  "pm.test('devolve token', () => pm.expect(token).to.be.a('string').and.not.empty);",
                  "pm.test('devolve o mesmo usuário cadastrado', () => {",
                  "  pm.expect(usuario.id).to.eql(pm.collectionVariables.get('usuarioId'));",
                  "});",
                  "// Encadeamento: as próximas requisições usam este token",
                  "pm.collectionVariables.set('token', token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"senha\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Recusar senha incorreta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));"
