{
  "openapi": "3.0.3",
  "info": {
    "title": "Inscrevi API",
    "version": "1.0.0",
    "description": "API do sistema de inscrição em minicursos usado no curso \"A Sprint de um QA\". As regras de negócio completas estão em sprint/backlog.md."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api"
    }
  ],
  "tags": [
    {
      "name": "Usuários"
    },
    {
      "name": "Login"
    },
    {
      "name": "Cursos"
    },
    {
      "name": "Inscrições"
    },
    {
      "name": "Conta"
    },
    {
      "name": "Lista de espera"
    },
    {
      "name": "Presença e certificado"
    },
    {
      "name": "Apoio a testes"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Erro": {
        "type": "object",
        "properties": {
          "mensagem": {
            "type": "string"
          }
        }
      },
      "NovoUsuario": {
        "type": "object",
        "required": [
          "nome",
          "email",
          "senha"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "example": "Ana Lima"
          },
          "email": {
            "type": "string",
            "example": "ana@exemplo.com"
          },
          "senha": {
            "type": "string",
            "example": "Senha@123"
          }
        }
      },
      "Usuario": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "perfil": {
            "type": "string",
            "enum": [
              "aluno",
              "admin"
            ]
          },
          "criadoEm": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Login": {
        "type": "object",
        "required": [
          "email",
          "senha"
        ],
        "properties": {
          "email": {
            "type": "string",
            "example": "maria@inscrevi.dev"
          },
          "senha": {
            "type": "string",
            "example": "Senha@123"
          }
        }
      },
      "Sessao": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "usuario": {
            "$ref": "#/components/schemas/Usuario"
          }
        }
      },
      "NovoCurso": {
        "type": "object",
        "required": [
          "titulo",
          "data",
          "inicio",
          "fim",
          "vagas"
        ],
        "properties": {
          "titulo": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "example": "2026-10-09"
          },
          "inicio": {
            "type": "string",
            "example": "19:00"
          },
          "fim": {
            "type": "string",
            "example": "21:00"
          },
          "vagas": {
            "type": "integer",
            "example": 10
          },
          "local": {
            "type": "string"
          },
          "ministrante": {
            "type": "string"
          },
          "preRequisitos": {
            "type": "string"
          }
        }
      },
      "Curso": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "titulo": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "data": {
            "type": "string"
          },
          "inicio": {
            "type": "string"
          },
          "fim": {
            "type": "string"
          },
          "vagas": {
            "type": "integer"
          },
          "local": {
            "type": "string"
          },
          "inscritos": {
            "type": "integer"
          },
          "vagasDisponiveis": {
            "type": "integer"
          },
          "ministrante": {
            "type": "string"
          },
          "preRequisitos": {
            "type": "string"
          }
        }
      },
      "Inscricao": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "usuarioId": {
            "type": "integer"
          },
          "cursoId": {
            "type": "integer"
          },
          "criadaEm": {
            "type": "string",
            "format": "date-time"
          },
          "curso": {
            "$ref": "#/components/schemas/Curso"
          },
          "presencaRegistrada": {
            "type": "boolean",
            "description": "Presente apenas na listagem de inscrições de um usuário"
          }
        }
      },
      "EntradaListaEspera": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "usuarioId": {
            "type": "integer"
          },
          "cursoId": {
            "type": "integer"
          },
          "criadaEm": {
            "type": "string",
            "format": "date-time"
          },
          "posicao": {
            "type": "integer"
          }
        }
      }
    }
  },
  "paths": {
    "/usuarios": {
      "post": {
        "tags": [
          "Usuários"
        ],
        "summary": "Cadastrar usuário (US01)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NovoUsuario"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuário criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "409": {
            "description": "E-mail já cadastrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": [
          "Login"
        ],
        "summary": "Entrar (US02)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sessao"
                }
              }
            }
          },
          "401": {
            "description": "Credenciais inválidas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/usuarios/me": {
      "get": {
        "tags": [
          "Usuários"
        ],
        "summary": "Usuário logado",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Usuário",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Conta"
        ],
        "summary": "Corrigir o próprio nome (US10)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 80
                  }
                },
                "required": [
                  "nome"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nome atualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                }
              }
            }
          },
          "400": {
            "description": "Nome fora dos limites ou tentativa de alterar outro campo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/usuarios/{id}/inscricoes": {
      "get": {
        "tags": [
          "Inscrições"
        ],
        "summary": "Listar inscrições de um usuário (US05)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID do usuário",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Inscrições",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Inscricao"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "403": {
            "description": "Sem permissão",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Usuário não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/cursos": {
      "get": {
        "tags": [
          "Cursos"
        ],
        "summary": "Listar cursos (US03)",
        "responses": {
          "200": {
            "description": "Cursos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Curso"
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "busca",
            "in": "query",
            "required": false,
            "description": "Texto procurado no título e na descrição, sem diferenciar maiúsculas nem acentos (US12)",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "tags": [
          "Cursos"
        ],
        "summary": "Criar curso (admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NovoCurso"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Curso criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Curso"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "403": {
            "description": "Não é admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/cursos/{id}": {
      "get": {
        "tags": [
          "Cursos"
        ],
        "summary": "Detalhar curso",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID do curso",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Curso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Curso"
                }
              }
            }
          },
          "404": {
            "description": "Não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Cursos"
        ],
        "summary": "Excluir curso (admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID do curso",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Excluído"
          },
          "404": {
            "description": "Não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "409": {
            "description": "Curso com inscrições",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/inscricoes": {
      "post": {
        "tags": [
          "Inscrições"
        ],
        "summary": "Inscrever-se em um curso (US04)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "cursoId"
                ],
                "properties": {
                  "cursoId": {
                    "type": "integer",
                    "example": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Inscrição criada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Inscricao"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Curso não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "409": {
            "description": "Sem vagas, já inscrito ou conflito de horário",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/inscricoes/{id}": {
      "delete": {
        "tags": [
          "Inscrições"
        ],
        "summary": "Cancelar inscrição (US06)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID da inscrição",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Cancelada"
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "403": {
            "description": "Inscrição de outro usuário",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Não encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/test/reset": {
      "post": {
        "tags": [
          "Apoio a testes"
        ],
        "summary": "Restaurar os dados iniciais",
        "description": "Rota exclusiva para ambiente de teste.",
        "responses": {
          "204": {
            "description": "Dados restaurados"
          }
        }
      }
    },
    "/logout": {
      "post": {
        "tags": [
          "Conta"
        ],
        "summary": "Sair da conta (US08)",
        "description": "Invalida o token usado na requisição.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Sessão encerrada"
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/recuperar-senha": {
      "post": {
        "tags": [
          "Conta"
        ],
        "summary": "Pedir link de redefinição de senha (US09)",
        "description": "Responde sempre da mesma forma, exista ou não uma conta com o e-mail. O link vale 30 minutos e uma única vez. Neste ambiente o e-mail não é enviado de verdade: fica na caixa de saída (GET /emails).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pedido registrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensagem": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/redefinir-senha": {
      "post": {
        "tags": [
          "Conta"
        ],
        "summary": "Definir nova senha com o token do link (US09)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string"
                  },
                  "senha": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 64
                  }
                },
                "required": [
                  "token",
                  "senha"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Senha alterada; as sessões abertas da conta são encerradas"
          },
          "400": {
            "description": "Senha fora da regra, ou link inválido, expirado ou já usado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/emails": {
      "get": {
        "tags": [
          "Apoio a testes"
        ],
        "summary": "Caixa de saída dos e-mails simulados (apenas admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Últimos 50 e-mails",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer"
                      },
                      "para": {
                        "type": "string"
                      },
                      "assunto": {
                        "type": "string"
                      },
                      "corpo": {
                        "type": "string"
                      },
                      "enviadoEm": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "403": {
            "description": "Não é administrador",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/lista-espera": {
      "get": {
        "tags": [
          "Lista de espera"
        ],
        "summary": "Minhas listas de espera (US07)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Entradas da pessoa logada, com a posição em cada fila",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EntradaListaEspera"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/cursos/{id}/lista-espera": {
      "post": {
        "tags": [
          "Lista de espera"
        ],
        "summary": "Entrar na lista de espera (US07)",
        "description": "Só para minicursos sem vagas. A fila tem no máximo 10 pessoas. Quando alguém cancela, a primeira pessoa da fila sem conflito de horário é inscrita.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
