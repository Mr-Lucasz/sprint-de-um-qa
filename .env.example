# Copie para .env.hospedado e preencha. Só é necessário para rodar o Inscrevi
# contra um Postgres de verdade; "npm start" funciona sem nada disto.

# Connection string do Postgres (no Neon, use o host com "-pooler")
DATABASE_URL=postgresql://usuario:senha@host-pooler.regiao.aws.neon.tech/neondb?sslmode=require

# Senha do painel em /instrutor. Sem ela o painel não existe.
INSTRUTOR_SENHA=

# Segredo que assina o cookie do painel (qualquer texto longo e aleatório)
SEGREDO_COOKIE=

# Opcional: endereço das issues do repositório, vira o link "Relatar defeito" do rodapé
URL_DEFEITOS=
